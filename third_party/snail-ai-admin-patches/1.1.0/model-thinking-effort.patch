+/**
+ * reasoning_effort 是 OpenAI 兼容请求体中的可选字段。
+ * 通过 extraBody 保存，确保设置值与现有 JSON 编辑器双向同步。
+ */
+const reasoningEffort = computed<string>({
+  get: () => (typeof config.extraBody?.reasoning_effort === 'string' ? config.extraBody.reasoning_effort : ''),
+  set: value => {
+    const current = config.extraBody;
+    const extraBody = current && typeof current === 'object' && !Array.isArray(current) ? { ...current } : {};
+    if (value) {
+      extraBody.reasoning_effort = value;
+    } else {
+      delete extraBody.reasoning_effort;
+    }
+    config.extraBody = extraBody;
+  }
+});
+
+/**
+ * 保留尚未列入快捷选项的已有供应商取值，避免编辑其他设置时误清除它。
+ */
+const reasoningEffortOptions = computed(() => {
+  const currentValue = reasoningEffort.value;
+  if (currentValue && !REASONING_EFFORT_OPTIONS.some(option => option.value === currentValue)) {
+    return [...REASONING_EFFORT_OPTIONS, { value: currentValue, label: `自定义 (${currentValue})` }];
+  }
+  return REASONING_EFFORT_OPTIONS;
+});
+
+function handleReasoningEffortChange(event: Event) {
+  const target = event.target;
+  if (target instanceof HTMLSelectElement) {
+    reasoningEffort.value = target.value;
+  }
