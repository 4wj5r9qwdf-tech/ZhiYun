#!/usr/bin/env bash
# 织云文件元信息
# 文件版本：v1.0
# 文件用途：从 WSL 调用 Windows 浏览器打开指定 URL 的开发辅助脚本。
# 功能目的：让 WSL 命令行中的网页链接可通过 Windows 桌面浏览器打开。
# 设计思路：保留 URL 原样传递，并按参数选择默认浏览器或指定浏览器。
# 实现方法：解析命令行参数后调用 Windows 侧浏览器启动入口。
# 关键约束：只负责启动浏览器，不下载页面、不处理认证信息或页面内容；保持 shebang 位于文件首行。
# 依赖与引用：WSL；Windows 浏览器；bin/wsl-open.rc。
# 初始开发人员：JY
# 初始开发时间：实际开发时间待追溯；首次纳入版本库：2026-10-24T18:20:35+08:00
# 当前责任人：JY（项目维护责任）
# 最近修改人员：JY（Codex辅助）
# AI辅助工具：Codex（智能体）
# 最近修改时间：2026-11-25
# 修改标记：ZY-ERP-20261125-文件头补齐；按当前开发规范补全元信息字段，仅调整注释。
# 测试时间：2026-11-20T18:02:03+08:00
# 测试人员：Codex（文件头元信息核对）
# 测试状态：头部字段核对通过；本次未重跑业务功能测试，既有结果见对应功能验收记录。
# 最近测试时间：2026-11-25
# 最近测试人员：JY（测试责任人）；AI辅助工具：Codex（静态核对）
# 最近测试状态：通过；检查文件头注释闭合、Git 差异检查通过且正文逐字节不变；未执行构建或业务运行测试。
# 说明：织云 ERP 项目文件：bin/wsl-open

# wsl-open <url>  —  从 WSL 直接调用 Windows 侧浏览器
# 用法:
#   wsl-open https://github.com/...     # 默认 Chrome
#   wsl-open -e https://...             # 指定 Edge
#   wsl-open -c https://...             # 指定 Chrome
set -euo pipefail

BROWSER="${WSL_BROWSER:-chrome}"
URL="${1:-}"

if [[ "${1:-}" == "-c" || "${1:-}" == "-e" ]]; then
  BROWSER="$1"
  URL="${2:-}"
fi

if [[ -z "$URL" ]]; then
  echo "用法: wsl-open [-c|-e] <url>" >&2
  echo "  -c  用 Chrome (默认)" >&2
  echo "  -e  用 Edge" >&2
  exit 1
fi

case "$BROWSER" in
  chrome)
    "/mnt/c/Program Files/Google/Chrome/Application/chrome.exe" "$URL" &
    ;;
  edge)
    "/mnt/c/Program Files/Microsoft/Edge/Application/msedge.exe" "$URL" &
    ;;
  *)
    echo "未知浏览器: $BROWSER (可用: chrome, edge)" >&2
    exit 1
    ;;
esac

echo "已在 Windows 侧用 $BROWSER 打开: $URL"
