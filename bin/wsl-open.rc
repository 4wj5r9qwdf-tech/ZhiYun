# 最近测试人员：JY（测试责任人）；AI辅助工具：Codex（静态核对）
# 最近测试状态：通过；检查文件头注释闭合、Git 差异检查通过且正文逐字节不变；未执行构建或业务运行测试。
# 说明：织云 ERP 项目文件：bin/wsl-open.rc

# 在 shell 里 source 一次即可:  source /home/it/ZhiYun/bin/wsl-open.rc
export PATH="/home/it/ZhiYun/bin:$PATH"
alias open='wsl-open'
alias wsl-open='/home/it/ZhiYun/bin/wsl-open'
echo "浏览器命令已加载: wsl-open <url> | wsl-open -e <url> (Chrome 默认, Edge 用 -e)"
