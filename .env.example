# 文件用途：列出织云开发环境变量名称和安全示例，供本机配置参考。
# 文件版本：1.0.0
# 功能目的：列出织云开发环境变量名称和安全示例，供本机配置参考。
# 设计思路：只提交变量名和非敏感默认值；实际密钥由本地环境变量提供。
# 实现方法：开发者复制示例并在本地配置；应用从环境变量读取，不从本文件读取生产凭据。
# 关键约束：不得填写真实密码、令牌或模型密钥。
# 依赖与引用：.gitignore；Docs/规范/部署与迁移.md
# 初始开发人员：JY（织云项目自研内容）
# 初始开发时间：待追溯（不以补录时间代替原始开发时间）
# 当前责任人：JY（项目维护责任；框架文件仅限项目改造范围）
# 最近修改人员：JY
# AI辅助工具：Codex（智能体）
# 最近修改时间：2026-11-20
# 修改标记：ZY-ERP-20261120-注释整理；补齐文件说明和业务逻辑注释，不改变运行行为
# 最近测试时间：本次整理未执行功能测试
# 测试人员：本次整理未执行
# 测试状态：待功能回归；历史测试记录待追溯
# 测试范围与记录位置：本次为注释/元信息整理；见 Docs/功能任务/ZY-ERP-20261120-既有功能注释整理.md
# 织云 ERP - 环境配置模板（进 Git；真实值写入 .env，.env 不进 Git）
# 规则：所有模型/网关端点、密钥、维度一律在此配置，代码只读本文件，禁止写死在代码/SQL 里
# 换环境（开发/测试/生产）只改这里，代码零改动

# ===== 数据库（占位，真实连接串走 .env；本地开发 PostgreSQL 16 + pgvector，端口 5432）=====
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=zhizhun_erp
DB_USER=
DB_PASSWORD=

# ===== Redis（缓存/消息：文件上传去重、基础资料导入导出、SSE 推送、吊挂幂等键、XXL-Job 分布式锁；apt redis-server 7.0.15）=====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== MinIO / 对象存储（S3 兼容：订单合同/图片、导出 Excel、logo、附件、知识库文档原件；Docker zhizhun-minio 服务）=====
# 凭据一律进 .env，不进代码/Git；DB 只存文件 key + 元信息，不存本体
OSS_ENDPOINT=http://127.0.0.1:9000
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=zhizhun-files

# ===== 并发容量红线（千人规模，走配置不写死代码）=====
# 任一满足才启动"应用加实例+负载均衡"扩容；一期单机+Redis 够
CAP_QPS_LIMIT=500
CAP_SLOW_SQL_RATIO=5
CAP_P99_MS=1000

# ===== LLM（OpenAI 兼容协议，可配多套 _1/_2）=====
LLM_1_BASE_URL=http://127.0.0.1:8000/v1
LLM_1_API_KEY=
LLM_1_MODEL=
# Codex CLI（终端开发用的那个 codex 命令）也走 OpenAI 兼容 base_url + key，
# 用下面这组专门给 CLI（和 ERP 内嵌 LLM 的 LLM_1 可分开配，避免互相影响）：
CODEX_CLI_BASE_URL=http://127.0.0.1:8000/v1
CODEX_CLI_API_KEY=
CODEX_CLI_MODEL=

# ===== TTS（语音合成，OpenAI 兼容 /v1/audio/speech）=====
TTS_1_BASE_URL=http://127.0.0.1:8000/v1
TTS_1_API_KEY=
TTS_1_MODEL=

# ===== ASR（语音转文字，OpenAI 兼容 /v1/audio/transcriptions）=====
ASR_1_BASE_URL=http://127.0.0.1:8000/v1
ASR_1_API_KEY=
ASR_1_MODEL=

# ===== EMBEDDING（本地 LM Studio，bge-large-zh-v1.5）=====
EMB_BASE_URL=http://127.0.0.1:1234/v1
EMB_API_KEY=lm-studio
EMB_MODEL=text-embedding-master
EMB_DIM=1024
EMB_MAX_TOKENS=512
# 注意：换 embedding 模型(维度变)时 EMB_DIM 随之改，且必须重建向量库(Chroma 向量空间不通用)
# 向量库自带"模型指纹"(EMB_MODEL+EMB_DIM+EMB_MAX_TOKENS)，程序启动/检索前校验；
# 换地址/换模型只需改本 .env 并重启，系统按下方开关自动判定旧向量库是否作废：
REBUILD_ON_MODEL_CHANGE=warn    # auto=模型/维度变化时启动自动全量重建向量库 / warn=报警+降级全文直读，由人工手动重建
# 换环境(开发内网 192.168.x / 生产服务器)只改上面 *_BASE_URL，代码零改动

# ===== 降级开关 =====
EMB_FALLBACK_FULLTEXT=1   # 向量端点不可达时，智能体回退"知识库全文直读"喂 LLM，避免向量库挂=智能体哑

# ===== 超管账号（不进数据库，走配置文件）=====
# 登录时先比对本配置，命中且密码对=超管（全厂全模块，不受组织树/岗位限制）
# Spring Boot Admin 监控台认证复用此账号凭据；监控服务仍需独立登录，不复用 ERP 页面会话。
# 其他普通账号走 sys_user 表（工号6位数字/手机号 + 密码，BCrypt）
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=

# SnailJob 本地开发服务数据库（独立 PostgreSQL 数据库，不与 ERP 业务库共用）
SNAILJOB_DB_HOST=127.0.0.1
SNAILJOB_DB_PORT=5432
SNAILJOB_DB_NAME=zhizhun_snailjob
SNAILJOB_DB_USER=snailjob_app
SNAILJOB_DB_PASSWORD=
SNAILJOB_BIND_ADDRESS=127.0.0.1
SNAILJOB_SERVER_HOST=127.0.0.1

# SnailAI 本地开发服务数据库与加密密钥（独立于 ERP 业务库）
SNAILAI_DB_HOST=127.0.0.1
SNAILAI_DB_PORT=5432
SNAILAI_DB_NAME=zhizhun_snailai
SNAILAI_DB_USER=snailai_app
SNAILAI_DB_PASSWORD=
SNAILAI_BIND_ADDRESS=127.0.0.1
SNAIL_AI_CRYPTO_KEY=
SNAIL_AI_CRYPTO_IV=
SNAIL_AI_RAG_DOCLING_ENABLED=false
SNAIL_AI_RAG_DOCLING_PADDLE_OCR_ENABLED=false

