# 织云 ERP - 环境配置模板（进 Git；真实值写入 .env，.env 不进 Git）
# 规则：所有模型/网关端点、密钥、维度一律在此配置，代码只读本文件，禁止写死在代码/SQL 里
# 换环境（开发/测试/生产）只改这里，代码零改动

# ===== 数据库（占位，真实连接串走 .env）=====
DB_HOST=127.0.0.1
DB_PORT=1433
DB_NAME=zhizhun_erp
DB_USER=
DB_PASSWORD=

# ===== LLM（OpenAI 兼容协议，可配多套 _1/_2）=====
LLM_1_BASE_URL=http://127.0.0.1:8000/v1
LLM_1_API_KEY=
LLM_1_MODEL=
# Codex CLI（终端开发用的那个 codex 命令）也走 OpenAI 兼容 base_url + key，
# 用下面这组专门给 CLI（和 ERP 内嵌 LLM 的 LLM_1 可分开配，避免互相影响）：
CODEX_CLI_BASE_URL=http://127.0.0.1:8000/v1
CODEX_CLI_API_KEY=
CODEX_CLI_MODEL=

# ===== TTS（语音合成，OpenAI 兼容 /v1/audio/speech）=====
TTS_1_BASE_URL=http://127.0.0.1:8000/v1
TTS_1_API_KEY=
TTS_1_MODEL=

# ===== ASR（语音转文字，OpenAI 兼容 /v1/audio/transcriptions）=====
ASR_1_BASE_URL=http://127.0.0.1:8000/v1
ASR_1_API_KEY=
ASR_1_MODEL=

# ===== EMBEDDING（本地 LM Studio，bge-large-zh-v1.5）=====
EMB_BASE_URL=http://127.0.0.1:1234/v1
EMB_API_KEY=lm-studio
EMB_MODEL=text-embedding-master
EMB_DIM=1024
EMB_MAX_TOKENS=512
# 注意：换 embedding 模型(维度变)时 EMB_DIM 随之改，且必须重建向量库(Chroma 向量空间不通用)
# 向量库自带"模型指纹"(EMB_MODEL+EMB_DIM+EMB_MAX_TOKENS)，程序启动/检索前校验；
# 换地址/换模型只需改本 .env 并重启，系统按下方开关自动判定旧向量库是否作废：
REBUILD_ON_MODEL_CHANGE=warn    # auto=模型/维度变化时启动自动全量重建向量库 / warn=报警+降级全文直读，由人工手动重建
# 换环境(开发内网 192.168.x / 生产服务器)只改上面 *_BASE_URL，代码零改动

# ===== 降级开关 =====
EMB_FALLBACK_FULLTEXT=1   # 向量端点不可达时，智能体回退"知识库全文直读"喂 LLM，避免向量库挂=智能体哑
